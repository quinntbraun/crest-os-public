{
  "name": "crest-os",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": "24.22.x",
    "npm": "11.19.1"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack && npm run build:server",
    "build:server": "node scripts/build-server.mjs",
    "start": "node .local/server/main.mjs",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:sign-in-browser": "node --test --test-concurrency=1 tests/integration/sign-in-browser.test.mjs tests/integration/customer-address-browser.test.mjs tests/integration/vehicle-http-browser.test.mjs",
    "test:tenant-read-db": "node --test --test-concurrency=1 tests/integration/tenant-read.test.mjs",
    "test:mutation-fence-db": "node --conditions=react-server --test --test-concurrency=1 tests/integration/mutation-fence.test.mjs",
    "test:operation-storage-db": "node --test --test-concurrency=1 tests/integration/operation-storage.test.mjs",
    "test:operation-lookup-db": "node --test --test-concurrency=1 tests/integration/operation-lookup.test.mjs",
    "test:business-name-db": "node --test --test-concurrency=1 tests/integration/business-name-command.test.mjs",
    "test:db": "node scripts/test-database.mjs",
    "test:sessions-db": "node --test --test-concurrency=1 tests/integration/session-foundation.test.mjs",
    "test:identity-db": "node --test --test-concurrency=1 tests/integration/identity-foundation.test.mjs",
    "test:security-db": "node --test --test-concurrency=1 tests/integration/security-schema.test.mjs",
    "test:migrations": "node --test --test-concurrency=1 tests/integration/migration-coordinator.test.mjs",
    "migrations:apply:test": "node scripts/apply-test-migrations.mjs",
    "verify:canonical": "node scripts/verify-canonical.mjs",
    "verify:public": "node scripts/verify-public.mjs",
    "verify:migrations": "node scripts/verify-migrations.mjs",
    "verify:dependencies": "node scripts/verify-dependencies.mjs",
    "check": "npm run verify:public && npm run verify:canonical && npm run verify:migrations && npm run verify:dependencies && npm run lint && npm run typecheck && npm test && npm run build",
    "audit:dependencies": "npm audit --audit-level=low",
    "release:manifest": "node scripts/release-manifest.mjs",
    "test:provider-db": "node --conditions=react-server --test --test-concurrency=1 tests/integration/provider-session.test.mjs",
    "test:login-admission-db": "node --conditions=react-server --test --test-concurrency=1 tests/integration/login-admission.test.mjs",
    "test:real-auth": "node --conditions=react-server --test --test-concurrency=1 tests/integration/real-auth.test.mjs",
    "test:session-commands-db": "node --conditions=react-server --test --test-concurrency=1 tests/integration/session-revocation.test.mjs",
    "test:business-settings-db": "node --test --test-concurrency=1 tests/integration/business-settings-context.test.mjs",
    "test:provider-cleanup-db": "node --test --test-concurrency=1 tests/integration/provider-cleanup-references.test.mjs",
    "test:provider-inventory-db": "node --test --test-concurrency=1 tests/integration/provider-session-inventory.test.mjs",
    "test:provider-evidence-db": "node --test --test-concurrency=1 tests/integration/provider-reconciliation-evidence.test.mjs",
    "test:provider-attempts-db": "node --test --test-concurrency=1 tests/integration/provider-login-attempts.test.mjs",
    "test:provider-targets-db": "node --test --test-concurrency=1 tests/integration/provider-login-targets.test.mjs",
    "test:login-fences-db": "node --test --test-concurrency=1 tests/integration/login-attempt-fences.test.mjs",
    "test:provider-requests-db": "node --test --test-concurrency=1 tests/integration/provider-cleanup-requests.test.mjs",
    "test:provider-executor-db": "node --conditions=react-server --test --test-concurrency=1 tests/integration/provider-cleanup-executor.test.mjs",
    "test:provider-export-db": "node --conditions=react-server --test --test-concurrency=1 tests/integration/provider-evidence-snapshot.test.mjs tests/integration/provider-reference-snapshot.test.mjs",
    "test:provider-review-db": "node --conditions=react-server --test --test-concurrency=1 tests/integration/provider-reconciliation-review.test.mjs",
    "test:recovery-db": "node --test --test-concurrency=1 tests/integration/recovery-drill.test.mjs",
    "test:private-files": "node --conditions=react-server --test --test-concurrency=1 tests/integration/private-object-store.test.mjs",
    "test:image-validation": "node --conditions=react-server --test --test-concurrency=1 tests/integration/image-validation.test.mjs",
    "test:image-sandbox": "node --test --test-concurrency=1 tests/integration/image-sandbox.test.mjs",
    "test:pdf-validation": "node --conditions=react-server --test --test-concurrency=1 tests/integration/pdf-validation.test.mjs",
    "test:pdf-sandbox": "node --test --test-concurrency=1 tests/integration/pdf-sandbox.test.mjs",
    "test:heic-validation": "node --conditions=react-server --test --test-concurrency=1 tests/integration/heic-validation.test.mjs",
    "test:heic-sandbox": "node --test --test-concurrency=1 tests/integration/heic-sandbox.test.mjs",
    "test:file-intake": "node --conditions=react-server --test --test-concurrency=1 tests/integration/validated-file-intake.test.mjs",
    "test:object-recovery": "node --test --test-concurrency=1 tests/integration/object-recovery.test.mjs",
    "test:customers-db": "node --test --test-concurrency=1 tests/integration/customer-directory.test.mjs",
    "test:addresses-db": "node --test --test-concurrency=1 tests/integration/customer-address-directory.test.mjs",
    "test:vehicles-db": "node --test --test-concurrency=1 tests/integration/vehicle-directory.test.mjs",
    "test:associations-db": "node --test --test-concurrency=1 tests/integration/vehicle-associations.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@aws-sdk/s3-request-presigner": "3.1156.0",
    "@hyzyla/pdfium": "3.0.0",
    "@supabase/auth-js": "2.118.0",
    "jose": "6.2.13",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fflate": "0.8.3",
    "globals": "17.13.0",
    "otpauth": "9.5.2",
    "rolldown": "1.2.14",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
